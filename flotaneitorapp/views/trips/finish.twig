{% extends "layout.twig" %}
{% block title %} Finalizar Trayecto {% endblock %}
{% block main_container %}
    <h2>Finalizar trayecto para {{ trip.plate }}</h2>
    {% if error %}
        <div class="alert alert-danger">
            {{ error }}
        </div>
    {% endif %}
    <form method="POST" action="/trips/finish/{{ trip._id }}">
        <div class="form-group">
            <label>Odómetro final (km):</label>
            <label>
                <input type="number" class="form-control" name="endingOdometer"  step="0.01">
            </label>
        </div>
        <div class="form-group">
            <label>Observaciones (opcional):</label>
            <label>
                <textarea class="form-control" name="observation" rows="4"></textarea>

            </label>
        </div>
        <button type="submit" class="btn btn-primary">Finalizar trayecto</button>
    </form>
{% endblock %}