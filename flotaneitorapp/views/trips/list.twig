{% extends "layout.twig" %}
{% block title %} Mis trayectos {% endblock %}
{% block main_container %}
<h2>Mis trayectos</h2>
    {% if message %}
        <div class="alert {{ messageType }}">
            {{ message }}
        </div>
    {% endif %}
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
        <tr>
            <th> Fecha y hora de inicio</th>
            <th>Matrícula</th>
            <th>Duración</th>
            <th>Odómetro inicial</th>
            <th>Odómetro final</th>
            <th class="col-md-1"></th>
        </tr>
        </thead>
        <tbody>
        {% for trip in trips %}
        <tr>
            <td>{{ trip.startDateTime }}</td>
            <td>{{ trip.plate }}</td>
            <td>{{ trip.duration }}</td>
            <td>{{ trip.startingOdometer }}</td>
            <td>{{ trip.endingOdometer }}</td>
            <td>
                {% if not trip.endingOdometer %}
                    <a href="/trips/finish/{{ trip._id }}">Finalizar</a>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
<div class="row text-right">
    <a href="/trips/start" class="btn btn-info" role="button">Registrar inicio de trayecto</a>
</div>
    <!-- Paginación mostrar la actual y 2 anteriores y dos siguientes -->
    <div class="row text-center">
        <ul class="pagination">
            {%  for page in pages %}
                <li class="page-item" id="pi-{{ page }}">
                    <a class="page-link" href="/trips?page={{ page }}">{{ page }}</a>
                </li>
            {% endfor %}
            <script>
                $("#pi-"+"{{ currentPage }}").addClass("active");
            </script>
        </ul>
    </div>
{% endblock %}