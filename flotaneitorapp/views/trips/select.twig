{% extends "layout.twig" %}

{% block title %}Historial de trayectos{% endblock %}

{% block main_container %}
    <h2>Consultar historial de trayectos</h2>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Matrícula</th>
                <th class="col-md-2">Acciones</th>
            </tr>
            </thead>
            <tbody>
            {% for vehicle in vehicles %}
                <tr>
                    <td>{{ vehicle.plate }}</td>
                    <td>
                        <form method="GET" action="/vehicles/trips/{{ vehicle.plate }}" class="m-0 p-0">
                            <button type="submit" class="btn btn-primary">Ver trayectos del vehículo</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
