{% extends "layout.twig" %}
{% block title %} Agregar empleado {%  endblock %}
{% block main_container %}
    {% if error %}
        <div class="alert alert-danger">
            {{ error }}
        </div>
    {% endif %}
    <h2>Agregar Empleado</h2>
    <form class="form-horizontal" method="post" action="/employees/add">
        <div class="form-group">
            <label class="control-label col-sm-2" for="dni">DNI: </label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="dni" name="dni" placeholder = "12345678D" value="{{ formData.dni }}" required/>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="name">Nombre: </label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="name" name="name" placeholder = "Pepito" value="{{ formData.name }}" required/>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="surname">Apellido: </label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="surname" name="surname" placeholder = "Pepitoria" value="{{ formData.surname }}" required/>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <button type="submit" class="btn btn-primary">Agregar</button>
            </div>
        </div>
    </form>
{% endblock %}