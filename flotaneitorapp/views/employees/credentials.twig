{% extends "layout.twig" %}

{% block title %} Credenciales {% endblock %}

{% block main_container %}
    <div class="d-flex justify-content-center align-items-center" style="height: 80vh;">
        <div class="media col-xs-10 text-center">
            <div class="media-body">
                <h2>Usuario: {{ user.dni }} </h2>
                <h3> Contraseña: {{ user.password }} </h3>
            </div>
            <div>
                <a href="/employees/list" class="btn btn-info mt-3" role="button">Siguiente</a>
            </div>
        </div>
    </div>
{% endblock %}