{% extends "layout.twig" %}
{% block title %} Modificar empleado {%  endblock %}
{% block main_container %}
    <h2>Modificar Empleado</h2>
    <form class="form-horizontal" method="post" action="/employees/edit/{{ employee._id }}">
        <div class="form-group">
            <label class="control-label col-sm-2" for="dni">DNI: </label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="dni" name="dni" placeholder="12345678X" required
                value="{{ employee.dni }}"/>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="name">Nombre: </label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="name" name="name" placeholder="Pepito" required
                value="{{ employee.name }}"/>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="surname">Apellido: </label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="surname" name="surname" placeholder="Pepín" required
                value="{{ employee.surname }}"/>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="role">Rol: </label>
            {% if user.dni == employee.dni %}
                <div class="col-sm-10">
                    <select class="form-control" id="role" name="role" required>
                            <option value="{{ employee.role }}">
                                {{ employee.role }}
                            </option>
                    </select>
                </div>
            {% else %}
                <div class="col-sm-10">
                    <select class="form-control" id="role" name="role" required>
                        {% for role in roles %}
                            <option value="{{ role.name }}"
                                    {% if role.name == employee.role %}
                            selected
                                    {% endif %}>
                                {{ role.value }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <button type="submit" class="btn btn-primary">Modificar</button>
            </div>
        </div>
    </form>
{% endblock %}