{% extends "layout.twig" %}
{% block title %} Agregar vehículo {% endblock %}
{% block main_container %}
    {% if error %}
        <div class="alert alert-danger">
            {{ error }}
        </div>
    {% endif %}
    <h2>Agregar vehículo</h2>
    <form class="form-horizontal" method="post" action="/vehicles/add">
        <div class="form-group">
            <label class="control-label col-sm-2" for="plate">Matrícula:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="plate" name="plate"
                                                    placeholder="1234BCD" value="{{ formData.plate }}" />
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="chassisNumber">Nº de bastidor:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="chassisNumber" name="chassisNumber"
                                placeholder = "12345678912345679" value="{{ formData.chassisNumber }}" />
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="brand">Marca:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="brand" name="brand" placeholder= "Marca" value="{{ formData.brand }}" />
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="model">Modelo:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="model" name="model" placeholder="Modelo" value="{{ formData.model }}" />
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-sm-2" for="fuelType">Tipo de combustible:</label>
            <div class="col-sm-10">
                <select class="form-control" id="fuelType" name="fuelType">
                    <option value="gasolina" {% if formData.fuelType == 'GASOLINA' %}selected{% endif %}>Gasolina</option>
                    <option value="diesel" {% if formData.fuelType == 'DIESEL' %}selected{% endif %}>Diesel</option>
                    <option value="microhibrido" {% if formData.fuelType == 'MICROHIBRIDO' %}selected{% endif %}>Microhíbrido</option>
                    <option value="electrico" {% if formData.fuelType == 'ELECTRICO' %}selected{% endif %}>Eléctrico</option>
                    <option value="glp" {% if formData.fuelType == 'GLP' %}selected{% endif %}>GLP</option>
                    <option value="gnl" {% if formData.fuelType == 'GNL' %}selected{% endif %}>GNL</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
                <button type="submit" class="btn btn-primary">Agregar</button>
            </div>
        </div>
    </form>
{% endblock %}
