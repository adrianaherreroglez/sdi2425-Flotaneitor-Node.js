{% extends "layout.twig" %}

{% block title %} Trayectos del Vehículo {% endblock %}

{% block main_container %}
    <h3>Trayectos del vehículo {{ vehicle.plate }}</h3>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Fecha y hora de inicio</th>
                <th>Nombre del conductor</th>
                <th>Duración</th>
                <th>Kilómetros recorridos</th>
            </tr>
            </thead>
            <tbody>
            {% for trip in trips %}
                <tr>
                    <td>{{ trip.startDateTime | date("d-m-Y H:i") }}</td>
                    <td>{{ trip.name }}</td>
                    <td>{{ trip.duration }}</td>
                    <td>
                        {% if trip.endingOdometer %}
                            {{ (trip.endingOdometer - trip.startingOdometer) | number_format(2, ',', '.') }} km
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <!-- Paginación mostrar la actual y 2 anteriores y dos siguientes -->
    <div class="row text-center">
        <ul class="pagination">
            {%  for page in pages %}
                <li class="page-item" id="pi-{{ page }}">
                    <a class="page-link" href="/vehicles/trips/{{ vehicle.plate }}?page={{ page }}">{{ page }}</a>
                </li>
            {% endfor %}
            <script>
                $("#pi-"+"{{ currentPage }}").addClass("active");
            </script>
        </ul>
    </div>
{% endblock %}
